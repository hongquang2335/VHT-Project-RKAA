+        [
+            {
+                "ne_id": "NE1",
+                "cell_id": "C1",
+                "kpi_name": "ENDC_SSR",
+                "temporal_profile": "BUSY",
+                "day_type": "WEEKDAY",
+                "post_mean": post_mean,
+                "delta_mean": delta_mean,
+                "delta_percent": delta_percent,
+            }
+        ]
+    )
+
+
+def _baseline() -> pd.DataFrame:
+    return pd.DataFrame(
+        [
+            {
+                "ne_id": "NE1",
+                "cell_id": "C1",
+                "kpi_name": "ENDC_SSR",
+                "temporal_profile": "BUSY",
+                "day_type": "WEEKDAY",
+                "sample_count": 100,
